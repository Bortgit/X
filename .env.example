# Copia este archivo a ".env" y ajusta los valores. Nunca subas ".env" a git.

# --- Regla principal: archivo de la historia activa ---
BLACKSTORIE_DIR=blackstorie
BLACKSTORIE_FILE=blackstorie.txt
BLACKSTORIE_README=LEEME.txt
MAX_STORY_CHARS=20000

# --- Base de datos ---
DB_PATH=blackstories.db

# --- Modelo de IA: "ollama", "claude" o "none" ---
MODEL_PROVIDER=none

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# API de Claude (Anthropic) - usa un modelo pequeño por defecto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

MODEL_TIMEOUT_SECONDS=20

# --- Protecciones ---
MAX_QUESTIONS_PER_STORY=40
RATE_LIMIT_PER_MINUTE=6
DAILY_GLOBAL_LIMIT=500

# Interruptor de apagado: pon BOT_SHUTDOWN=1 o crea un archivo llamado
# como SHUTDOWN_FILE en la raiz del proyecto para que el bot deje de
# responder por completo.
BOT_SHUTDOWN=0
SHUTDOWN_FILE=SHUTDOWN

# --- Instagram / Meta (rellenar cuando tengas la app creada) ---
IG_VERIFY_TOKEN=
IG_APP_SECRET=
IG_PAGE_ACCESS_TOKEN=
IG_GRAPH_API_VERSION=v21.0
